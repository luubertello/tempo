# Copiar este archivo como ".env" y completar los valores.
# NUNCA subir el .env real al repositorio.

# Puerto de la API
PORT=3000

# PostgreSQL (el contenedor de docker-compose usa estos mismos valores)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=entrenamiento

# Autenticación
JWT_SECRET=
JWT_EXPIRES_IN=1d